# ==============================================================================
# HOSPITAL MANAGEMENT & AI AGENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL / PRISMA RELATIONAL DDL)
# ------------------------------------------------------------------------------
# Supabase Transaction Pooler (Port 6543) for application queries
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/hospital_db?schema=public
# Supabase Direct Connection (Port 5432) for Prisma schema migrations
DIRECT_URL=postgresql://postgres:postgrespassword@localhost:5432/hospital_db?schema=public

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-hospital-jwt-key-change-in-production-2026
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. BRAND DESIGN TOKENS (CLINICAL 5-COLOR PALETTE)
# ------------------------------------------------------------------------------
COLOR_BASE_SURFACE=#E0FBFC       # Clinical Ice Cyan (Canvas, list row selection)
COLOR_SECONDARY_SURFACE=#C2DFE3  # Soft Blue-Gray (Cards, panels, inputs)
COLOR_STRUCTURAL_GRID=#9DB4C0    # Muted Slate (Borders, dividers, tracks)
COLOR_LABEL_INK=#5C6B73          # Dark Slate Gray (Metadata, timestamps)
COLOR_CONTRAST_INK=#253237       # Deep Charcoal Ink (Typography, primary buttons)

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI AGENT RUNTIME & COPILOT
# ------------------------------------------------------------------------------
# Available Models: gemini-3.8-flash, gemini-3.8-pro, gemini-2.5-pro, gemini-2.5-flash
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your-gemini-api-key-here
AI_API_KEY=your-gemini-api-key-here
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=2048

# ------------------------------------------------------------------------------
# 6. MULTI-CHANNEL NOTIFICATION FAILOVER ENGINE
# ------------------------------------------------------------------------------
# Primary Channel Adapter: WhatsApp (Meta Cloud API / Twilio)
WHATSAPP_API_KEY=mock-whatsapp-key
WHATSAPP_PHONE_NUMBER_ID=1000123456789
WHATSAPP_BUSINESS_ACCOUNT_ID=2000123456789

# Cellular SMS Gateway Adapter (Twilio / Infobip / Vonage)
SMS_GATEWAY_KEY=mock-sms-key
SMS_SENDER_ID=HOSPITAL_ALERT

# Secure SMTP Mailer Adapter
SMTP_HOST=smtp.hospital.com
SMTP_PORT=587
SMTP_USER=notifications@hospital.com
SMTP_PASS=mock-smtp-password
SMTP_FROM_EMAIL="Aesthetic Clinical Hospital <no-reply@hospital.com>"

# ------------------------------------------------------------------------------
# 7. BUSINESS LOGIC ENGINE & CAPACITY POLICIES
# ------------------------------------------------------------------------------
DEFAULT_DAILY_PATIENT_LIMIT=100
LATE_CHECKIN_GRACE_PERIOD_MINUTES=30
AUTO_NO_SHOW_THRESHOLD_HOURS=4
PERMANENT_TOKEN_CANCELLATION=true
STRICT_DUPLICATE_CHECK=true
