{
  "name": "hospital-management-system",
  "version": "1.0.0",
  "description": "Hospital Management & AI Agent System with Concurrency-Safe Tokens, Git-Style Prescription Versioning, and Clinical Command Deck",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "dev:ports": "node client/multi-port-server.js",
    "dev:all": "concurrently -n \"BACKEND,VITE,PORTS\" -c \"cyan,green,yellow\" \"npm run dev\" \"npm run dev:client\" \"npm run dev:ports\"",
    "seed": "ts-node prisma/seed.ts",
    "test": "ts-node test/system.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [
    "hospital-management",
    "ai-agent",
    "clinical-command-deck",
    "tokens",
    "prescriptions",
    "rbac"
  ],
  "author": "Antigravity Engineering",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.4",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "prisma": "^5.19.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
